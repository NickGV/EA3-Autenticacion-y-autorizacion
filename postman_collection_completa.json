						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipo_identificacion\": \"CC\",\n  \"numero_identificacion\": \"1008888888\",\n  \"nombres\": \"Laura\",\n  \"apellidos\": \"Rodríguez Torres\",\n  \"estado_civil\": \"Soltera\",\n  \"sexo\": \"F\",\n  \"direccion\": \"Calle 80 #25-40\",\n  \"telefono\": \"3157778899\",\n  \"fecha_nacimiento\": \"1995-07-20\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/funcionarios",
							"host": ["{{base_url}}"],
							"path": ["api", "funcionarios"]
						}
					}
				},
				{
					"name": "Actualizar Funcionario",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"telefono\": \"3001112233\",\n  \"direccion\": \"Nueva Dirección Calle 50 #10-20\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/funcionarios/1",
							"host": ["{{base_url}}"],
							"path": ["api", "funcionarios", "1"]
						}
					}
				},
				{
					"name": "Eliminar Funcionario",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {
							"raw": "{{base_url}}/api/funcionarios/3",
							"host": ["{{base_url}}"],
							"path": ["api", "funcionarios", "3"]
						},
						"description": "Solo ADMIN - Elimina el funcionario y sus relaciones (CASCADE)"
					}
				}
			]
		},
