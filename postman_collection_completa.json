		{
			"name": "6. Pruebas de Autorización",
			"item": [
				{
					"name": "Acceder sin Token (Error)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/funcionarios",
							"host": ["{{base_url}}"],
							"path": ["api", "funcionarios"]
						},
						"description": "Debe retornar 401 - No se proporcionó token"
					}
				},
				{
					"name": "Usuario sin permisos crear funcionario",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token_user}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipo_identificacion\": \"CC\",\n  \"numero_identificacion\": \"1009999999\",\n  \"nombres\": \"Test\",\n  \"apellidos\": \"Test\",\n  \"sexo\": \"M\"\n}"
						},
